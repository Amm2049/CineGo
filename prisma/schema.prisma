// prisma/schema.prisma
// CineGo — Database Schema (Phase 2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF // door staff: ticket scanner only
  ADMIN
}

enum BookingStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING // Stripe PromptPay QR shown, waiting for the customer (Phase 9)
  SUCCESS
  FAILED
  CANCELLED // payment window closed or customer cancelled; QR no longer payable
  REFUNDED // paid after the seats were lost, money returned automatically
}

enum PaymentProvider {
  SIMULATED
  STRIPE
}

enum TicketStatus {
  ACTIVE
  USED
}

// ── Models ─────────────────────────────────────────────────

model User {
  id                       String         @id @default(uuid())
  email                    String         @unique
  name                     String?
  passwordHash             String? // null for accounts created with "Continue with Google"
  role                     Role           @default(CUSTOMER)
  recommendations          Json?
  recommendationsUpdatedAt DateTime?
  createdAt                DateTime       @default(now())
  bookings                 Booking[]
  interests                UserInterest[]
  scannedTickets           Ticket[]       @relation("TicketScannedBy")
}

model Genre {
  id     String         @id @default(uuid())
  name   String         @unique
  movies MovieGenre[]
  users  UserInterest[]
}

model UserInterest {
  userId  String
  genreId String
  user    User   @relation(fields: [userId], references: [id])
  genre   Genre  @relation(fields: [genreId], references: [id])

  @@id([userId, genreId])
}

model Movie {
  id          String       @id @default(uuid())
  tmdbId      Int?         @unique
  title       String
  description String
  duration    Int
  releaseDate DateTime
  posterUrl   String
  backdropUrl String
  isActive    Boolean      @default(true) // false = hidden from the catalog
  popularity  Float        @default(0) // TMDB popularity, refreshed by the sync; picks the home hero
  trailerKey  String? // YouTube video id of the trailer (from TMDB videos); null = no trailer
  genres      MovieGenre[]
  showtimes   Showtime[]
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id])
  genre   Genre  @relation(fields: [genreId], references: [id])

  @@id([movieId, genreId])
}

model Cinema {
  id       String   @id @default(uuid())
  name     String
  location String
  screens  Screen[]
}

model Screen {
  id        String     @id @default(uuid())
  cinemaId  String
  number    Int // Theatre number within the cinema (1, 2, 3, ...)
  name      String // Display name, e.g. "Theatre 1"
  format    String // Projection format, e.g. "IMAX Laser", "Dolby Cinema"
  cinema    Cinema     @relation(fields: [cinemaId], references: [id])
  seats     Seat[]
  showtimes Showtime[]

  @@unique([cinemaId, number])
}

model Seat {
  id       String        @id @default(uuid())
  screenId String
  rowLabel String
  seatNum  Int
  price    Decimal
  screen   Screen        @relation(fields: [screenId], references: [id])
  bookings BookingSeat[]
}

model Showtime {
  id       String        @id @default(uuid())
  movieId  String
  screenId String
  startsAt DateTime
  endsAt   DateTime
  movie    Movie         @relation(fields: [movieId], references: [id])
  screen   Screen        @relation(fields: [screenId], references: [id])
  bookings Booking[]
  seats    BookingSeat[]

  @@index([movieId, startsAt])
  @@index([screenId, startsAt]) // overlap check + "what is on this screen today"
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  showtimeId  String
  status      BookingStatus @default(PENDING)
  totalAmount Decimal
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  showtime    Showtime      @relation(fields: [showtimeId], references: [id])
  seats       BookingSeat[]
  payment     Payment?
  tickets     Ticket[] // one per seat, created when the booking is paid

  @@index([userId])
}

model BookingSeat {
  id              String    @id @default(uuid())
  bookingId       String
  showtimeId      String
  seatId          String
  priceAtPurchase Decimal
  heldUntil       DateTime?
  booking         Booking   @relation(fields: [bookingId], references: [id])
  showtime        Showtime  @relation(fields: [showtimeId], references: [id])
  seat            Seat      @relation(fields: [seatId], references: [id])
  ticket          Ticket?

  @@unique([showtimeId, seatId])
}

model Payment {
  id                   String          @id @default(uuid())
  bookingId            String          @unique
  provider             PaymentProvider @default(SIMULATED)
  status               PaymentStatus
  amount               Decimal
  transactionReference String          @unique // SIM-<uuid> or the Stripe PaymentIntent id (pi_...)
  createdAt            DateTime        @default(now())
  expiresAt            DateTime? // end of the 10-minute payment window (Stripe only)
  paidAt               DateTime? // set only when status becomes SUCCESS
  refundedAt           DateTime?
  booking              Booking         @relation(fields: [bookingId], references: [id])

  @@index([status, expiresAt])
}

// One ticket (QR) per booked seat: each seat is scanned on its own at the door.
model Ticket {
  id            String       @id @default(uuid())
  bookingId     String
  bookingSeatId String       @unique
  ticketCode    String       @unique
  qrPayload     String
  status        TicketStatus @default(ACTIVE)
  issuedAt      DateTime     @default(now())
  usedAt        DateTime? // when the scanner admitted the ticket
  scannedById   String? // who admitted it (ADMIN or STAFF user)
  booking       Booking      @relation(fields: [bookingId], references: [id])
  bookingSeat   BookingSeat  @relation(fields: [bookingSeatId], references: [id])
  scannedBy     User?        @relation("TicketScannedBy", fields: [scannedById], references: [id])

  @@index([bookingId])
}
