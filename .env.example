# ============================================================
# CineGo — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Database (Phase 2) ──────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / local)
DATABASE_URL=postgresql://user:password@localhost:5432/cinego

# ── Authentication (Phase 3) ────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Google Gemini API (Phase 6) ─────────────────────────────
# Get your key from: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# ── TMDB API (Optional: Live Movie Sync & Ingestion) ──────
# Get your key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here
# Optional v4 Read Access Token (Bearer):
TMDB_READ_ACCESS_TOKEN=your-tmdb-access-token-here

# ── Vercel Cron (Phase 8) ───────────────────────────────────
# Long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-long-random-cron-secret
