# ============================================================
# CineGo — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Database (Phase 2) ──────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / local)
DATABASE_URL=postgresql://user:password@localhost:5432/cinego

# ── Authentication (Phase 3) ────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Google Gemini API (Phase 6) ─────────────────────────────
# Get your key from: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# ── TMDB API (Optional: Live Movie Sync & Ingestion) ──────
# Get your key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here
# Optional v4 Read Access Token (Bearer):
TMDB_READ_ACCESS_TOKEN=your-tmdb-access-token-here

# ── Vercel Cron (Phase 8) ───────────────────────────────────
# Long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-long-random-cron-secret

# ── Production migrations (Phase 8) ─────────────────────────
# Optional: Neon direct (non-pooled) URL, used only by the Prisma CLI for migrations.
# Same as DATABASE_URL but without "-pooler" in the host name.
DIRECT_URL=

# ── Payments: Stripe PromptPay (Phase 9) ────────────────────
# "stripe" = PromptPay QR via Stripe test mode. Anything else / unset = simulated payment
# (CI, concurrency test, offline demos keep using the simulated payment).
PAYMENT_PROVIDER=simulated
# Test-mode secret key only (sk_test_… or rk_test_…); live keys are refused by src/lib/stripe.ts.
# Dashboard → Developers → API keys. The Stripe account must be a Thailand account with PromptPay enabled.
STRIPE_SECRET_KEY=sk_test_your-key-here
# Webhook signing secret (whsec_…). Local dev: printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Production: Dashboard → Developers → Webhooks → endpoint https://<your-app>/api/webhooks/stripe
# with events payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled.
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
